# Mobile App Environment Variables
# Copy this to .env and fill in your values

# Your local machine IP (for Expo development)
# Find with: ifconfig | grep "inet " (Mac/Linux) or ipconfig (Windows)
# In production this is ignored — the app uses https://api.abaydriver.et
API_BASE_URL=http://192.168.1.100:5000

# Google Maps API Key
# Get one at: https://console.cloud.google.com/
# Enable: Maps SDK for Android, Maps SDK for iOS, Directions API
GOOGLE_MAPS_API_KEY=AIzaSyBT2_j5NhOa-rD-4tKX5kf1iPOuP1vtVJk

# Production API URL (used by app.config.js for release builds)
# PRODUCTION_API_URL=https://api.abaydriver.et

# Sentry DSN — get from https://sentry.io (create a React Native project)
SENTRY_DSN=

# EAS Project ID — from `eas init` or https://expo.dev/accounts/<username>/projects
# Required for push notifications in production builds
EAS_PROJECT_ID=your-eas-project-id-here

# Android: path to google-services.json downloaded from Firebase Console
# Only needed for local builds; EAS Build reads it from eas.json credentials
GOOGLE_SERVICES_JSON=./google-services.json
