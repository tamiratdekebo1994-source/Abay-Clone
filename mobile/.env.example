# Mobile App Environment Variables
# Copy this to .env and fill in your values

# Your local machine IP (for Expo development)
# Find with: ifconfig | grep "inet " (Mac/Linux) or ipconfig (Windows)
# In production this is ignored — the app uses https://api.abaydriver.et
API_BASE_URL=http://192.168.1.100:5000

# Google Maps API Key
# Get one at: https://console.cloud.google.com/
# Enable: Maps SDK for Android, Maps SDK for iOS, Directions API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Production API URL (used by app.config.js for release builds)
# PRODUCTION_API_URL=https://api.abaydriver.et
