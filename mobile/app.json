{
  "expo": {
    "name": "ET Spark",
    "slug": "et-spark",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B4332"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.etspark.driver",
      "config": {
        "googleMapsApiKey": "AIzaSyBT2_j5NhOa-rD-4tKX5kf1iPOuP1vtVJk"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ET Spark needs your location to show nearby deliveries and update your position.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "ET Spark needs background location to track your delivery routes.",
        "NSCameraUsageDescription": "ET Spark needs camera access to upload documents.",
        "NSPhotoLibraryUsageDescription": "ET Spark needs photo library access to upload documents.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B4332"
      },
      "package": "com.etspark.driver",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBT2_j5NhOa-rD-4tKX5kf1iPOuP1vtVJk"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow ET Spark to use your location."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1B4332"
        }
      ]
    ],
    "scheme": "et-spark",
    "extra": {
      "googleMapsApiKey": "AIzaSyBT2_j5NhOa-rD-4tKX5kf1iPOuP1vtVJk",
      "eas": {
        "projectId": "9ec35099-d353-4072-bbbd-2504bcde96f6"
      }
    },
    "owner": "tamiratdekebo1994"
  }
}
