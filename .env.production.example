# ─── Abay Driver — Production Environment Variables ──────────────────────────
# Copy this file to .env and fill in every value before running:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# Generate secure secrets with:
#   openssl rand -hex 64
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=abay
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=abaydriver

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# ── JWT ───────────────────────────────────────────────────────────────────────
# Run: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_64_char_hex_secret
JWT_REFRESH_SECRET=CHANGE_ME_different_64_char_hex_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── URLs (set to your actual domain) ─────────────────────────────────────────
BACKEND_URL=https://abaydriver.et
FRONTEND_URL=https://abaydriver.et

# ── Africa's Talking SMS (OTP delivery) ──────────────────────────────────────
# Sign up at https://africastalking.com — use username "sandbox" for testing
AT_API_KEY=your-africastalking-api-key
AT_USERNAME=your-africastalking-username
AT_SENDER_ID=AbayDrvr

# ── Google Maps (turn-by-turn navigation & route polylines) ──────────────────
GOOGLE_MAPS_API_KEY=AIzaSyBT2_j5NhOa-rD-4tKX5kf1iPOuP1vtVJk

# ── TeleBirr payment gateway ──────────────────────────────────────────────────
# Obtain credentials from Ethio Telecom paygate partner portal
TELEBIRR_APP_ID=your-telebirr-app-id
TELEBIRR_APP_KEY=your-telebirr-app-key
TELEBIRR_SHORT_CODE=your-telebirr-short-code
TELEBIRR_BASE_URL=https://api.ethiotelecom.et/payment

# ── CBE Birr ──────────────────────────────────────────────────────────────────
CBE_MERCHANT_ID=your-cbe-merchant-id
CBE_SECRET_KEY=your-cbe-secret-key

# ── Awash Bank ────────────────────────────────────────────────────────────────
AWASH_MERCHANT_ID=your-awash-merchant-id
AWASH_WEBHOOK_SECRET=your-awash-webhook-secret

# ── Dashen Bank ───────────────────────────────────────────────────────────────
DASHEN_MERCHANT_ID=your-dashen-merchant-id
DASHEN_WEBHOOK_SECRET=your-dashen-webhook-secret

# ── S3-compatible file storage ────────────────────────────────────────────────
# Leave blank to store files on local disk (inside the uploads/ Docker volume).
# For production, use AWS S3, Cloudflare R2, or MinIO.
#
# Cloudflare R2 example:
#   AWS_S3_BUCKET=abay-driver-uploads
#   AWS_REGION=auto
#   AWS_ACCESS_KEY_ID=<R2 Access Key ID>
#   AWS_SECRET_ACCESS_KEY=<R2 Secret Access Key>
#   AWS_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
#   AWS_CDN_URL=https://cdn.abaydriver.et
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=
AWS_CDN_URL=

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# Used for driver approval, withdrawal status, and store verification emails.
# Supports any SMTP relay: Gmail, SendGrid, Mailgun, AWS SES.
#
# SendGrid example:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASS=SG.xxxxxxxxxxxxxxxx
#
# Gmail app password example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=xxxx-xxxx-xxxx-xxxx  (16-char app password, not your login password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Abay Driver <noreply@abaydriver.et>

# ── Sentry (error monitoring) ─────────────────────────────────────────────────
# Create a Node.js project at https://sentry.io to get a DSN.
SENTRY_DSN=

# ── Pricing defaults ──────────────────────────────────────────────────────────
BASE_FEE_ETB=50
PER_KM_FEE_ETB=15
PLATFORM_FEE_PERCENT=15
