NODE_ENV=development
PORT=5000

# Africa's Talking SMS (sign up at africastalking.com)
# Use 'sandbox' username + any apiKey for testing
AT_API_KEY=your-africastalking-api-key
AT_USERNAME=your-africastalking-username
AT_SENDER_ID=AbayDrvr

# Google Maps (for mobile app - web service)
GOOGLE_MAPS_API_KEY=AIzaSyBT2_j5NhOa-rD-4tKX5kf1iPOuP1vtVJk

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/abay_driver

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# URLs
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# Telebirr (Ethiopian mobile payment)
TELEBIRR_APP_ID=your-telebirr-app-id
TELEBIRR_APP_KEY=your-telebirr-app-key
TELEBIRR_SHORT_CODE=your-telebirr-short-code
TELEBIRR_BASE_URL=https://api.ethiotelecom.et/payment

# CBE Birr
CBE_MERCHANT_ID=your-cbe-merchant-id
CBE_SECRET_KEY=your-cbe-secret-key

# Awash Bank
AWASH_MERCHANT_ID=your-awash-merchant-id
AWASH_WEBHOOK_SECRET=your-awash-webhook-secret

# Dashen Bank
DASHEN_MERCHANT_ID=your-dashen-merchant-id
DASHEN_WEBHOOK_SECRET=your-dashen-webhook-secret

# Redis (optional but recommended in production for rate limiting)
# Format: redis://[:password@]host[:port][/db]
REDIS_URL=redis://localhost:6379

# Sentry (error monitoring — get DSN from https://sentry.io)
SENTRY_DSN=

# Firebase Storage (priority over S3 when both are set)
# Get service account JSON: Firebase Console → Project Settings → Service Accounts
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# S3-compatible object storage (AWS S3, Cloudflare R2, MinIO) — used if Firebase not set
# When set, all uploaded images are stored in S3 instead of local disk
AWS_S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_ENDPOINT_URL=https://<id>.r2.cloudflarestorage.com  # Cloudflare R2 / MinIO
# AWS_CDN_URL=https://cdn.abaydriver.et                   # CDN prefix for stored files

# Email / SMTP (Nodemailer — Gmail, SendGrid SMTP relay, Mailgun, AWS SES)
# When not set, email notifications are logged in dev and silently skipped in prod
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=Abay Driver <noreply@abaydriver.et>

# Pricing defaults
BASE_FEE_ETB=50
PER_KM_FEE_ETB=15
PLATFORM_FEE_PERCENT=15
