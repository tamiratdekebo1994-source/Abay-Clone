NODE_ENV=development
PORT=5000

# Africa's Talking SMS (sign up at africastalking.com)
# Use 'sandbox' username + any apiKey for testing
AT_API_KEY=your-africastalking-api-key
AT_USERNAME=your-africastalking-username
AT_SENDER_ID=AbayDrvr

# Google Maps (for mobile app - web service)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/abay_driver

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# URLs
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# Telebirr (Ethiopian mobile payment)
TELEBIRR_APP_ID=your-telebirr-app-id
TELEBIRR_APP_KEY=your-telebirr-app-key
TELEBIRR_SHORT_CODE=your-telebirr-short-code
TELEBIRR_BASE_URL=https://api.ethiotelecom.et/payment

# CBE Birr
CBE_MERCHANT_ID=your-cbe-merchant-id
CBE_SECRET_KEY=your-cbe-secret-key

# Pricing defaults
BASE_FEE_ETB=50
PER_KM_FEE_ETB=15
PLATFORM_FEE_PERCENT=15
