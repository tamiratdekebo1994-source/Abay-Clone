rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow Cloud Functions Admin SDK and authenticated users
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    match /drivers/{driverId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == driverId;
    }

    match /stores/{storeId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == storeId;
    }

    match /orders/{orderId} {
      allow read, write: if request.auth != null;
    }

    match /promoCodes/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /auditLogs/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /fraudFlags/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /commissionSettings/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
