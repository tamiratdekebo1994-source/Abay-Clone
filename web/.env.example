# Web Dashboard Environment Variables
# Copy this to .env and fill in your values

# Sentry DSN — get from https://sentry.io (create a React project)
VITE_SENTRY_DSN=

# Backend API origin — only set when hosting the web app on Firebase Hosting
# Leave blank when served from the same nginx/VPS as the backend
# Example: VITE_API_BASE_URL=https://api.abaydriver.et
VITE_API_BASE_URL=
